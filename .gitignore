# Runtime data -- the whole mutable state, never versioned.
# The folder itself stays in the repository, so that a fresh clone starts at once.
/data/*
!/data/.gitkeep

# The sample collection under seed/ is in the repository -- but invented: drawn pictures,
# made-up people. Built by tools/build_seed.py, see seed/README.md.
# Whoever develops against real photos takes them with `make seed-save` and does not commit
# them: the real pictures belong to the museum.

# Map data: too large for the repository, built with `make tiles`.
# Only the build script and tiles/region.json are versioned.
*.pmtiles
/frontend/public/tiles/
/frontend/public/basemaps/
/tiles/*.osm.pbf
/tiles/places.json

# Python
.venv/
# The environment for the documentation site, built by `make docs-serve`, and what it builds.
/.venv-docs/
/site/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# Build artefact of the editable install -- sat in the repository by accident until 15 August 2026.
*.egg-info/

# Node
node_modules/
/frontend/dist/
/release/
*.tsbuildinfo

# Configuration holding secrets (the PIN hash and the like)
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
