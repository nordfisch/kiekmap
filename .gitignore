# Laufzeitdaten — der gesamte veraenderliche Zustand, wird nie versioniert.
# Der Ordner selbst bleibt im Repo, damit ein frischer Clone sofort startet.
/data/*
!/data/.gitkeep

# Beispielbestand fuer Entwicklung und Test. Noch nicht im Repo: es sind echte Aufnahmen aus
# Holm, und ob wir sie mitliefern duerfen und wollen, ist offen -- siehe docs/backlog.md unter
# "Versionierung, Releaseprozess und Veroeffentlichung". Bis dahin holt sich jeder seinen eigenen
# ueber `make seed-save`; seed/README.md sagt, was dort hingehoert.
/seed/*
!/seed/README.md

# Kartendaten: zu gross fuers Repo, werden per `make tiles` gebaut.
# Versioniert wird nur das Bauskript und tiles/region.json.
*.pmtiles
/frontend/public/tiles/
/frontend/public/basemaps/
/tiles/*.osm.pbf
/tiles/places.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
/frontend/dist/
*.tsbuildinfo

# Konfiguration mit Geheimnissen (PIN-Hash o. ae.)
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
