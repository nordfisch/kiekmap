# Laufzeitdaten — der gesamte veraenderliche Zustand, wird nie versioniert.
# Der Ordner selbst bleibt im Repo, damit ein frischer Clone sofort startet.
/data/*
!/data/.gitkeep

# Der Beispielbestand unter seed/ liegt im Repo -- aber erfunden: gezeichnete Bilder,
# ausgedachte Menschen. Erzeugt von tools/build_seed.py, siehe seed/README.md.
# Wer mit echten Fotos entwickelt, holt sie sich ueber `make seed-save` und committet
# sie nicht: die echten Aufnahmen gehoeren dem Museum.

# Kartendaten: zu gross fuers Repo, werden per `make tiles` gebaut.
# Versioniert wird nur das Bauskript und tiles/region.json.
*.pmtiles
/frontend/public/tiles/
/frontend/public/basemaps/
/tiles/*.osm.pbf
/tiles/places.json

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
# Bauartefakt der editierbaren Installation -- lag bis zum 15. August 2026 versehentlich im Repo.
*.egg-info/

# Node
node_modules/
/frontend/dist/
/release/
*.tsbuildinfo

# Konfiguration mit Geheimnissen (PIN-Hash o. ae.)
.env
.env.local

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
