{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "docs",
      "runtimeExecutable": ".venv-docs/bin/mkdocs",
      "runtimeArgs": ["serve", "--dev-addr", "127.0.0.1:8001"],
      "port": 8001,
      "url": "http://localhost:8001"
    }
  ]
}
