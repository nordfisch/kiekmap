#!/bin/sh
#
# The checks no test ever runs. Which ones they are stands at the bottom of this file, and that
# list counts itself -- see docs/developer/decisions.md, point 59.
#
# Deliberately **without** the test suite: that runs anyway, because `make test` and `make check`
# execute it and nobody forgets it. What does get forgotten is what stands below, and together it
# is done in under a second -- a hook you notice is a hook that gets switched off.
#
# Switched on once per clone:
#
#     git config core.hooksPath .githooks
#
# Bypassed with `git commit --no-verify`, which is fine for a half-finished state in between.
# Before a push, `make check` belongs to have run.

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "Note: python3 is missing, the checks below are skipped." >&2
    exit 0
fi

# A function rather than a loop over names, since one of the checks needs an argument.
check() {
    script="$1"
    shift
    if ! python3 "tools/$script.py" "$@" >/dev/null; then
        echo "" >&2
        echo "  tools/$script.py has something to say. In full:" >&2
        echo "" >&2
        python3 "tools/$script.py" "$@" >&2 || true
        echo "" >&2
        echo "  (To bypass: git commit --no-verify)" >&2
        exit 1
    fi
}

check language_check
check check_anchors
check check_settings
check check_numbers
check check_translations
check build_register --check
check set_version --check
