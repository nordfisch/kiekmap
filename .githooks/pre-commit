#!/bin/sh
#
# Die vier Pruefungen, die kein Test je ausfuehrt -- Sprachregelung, Verweise in docs/, der Weg
# jeder Einstellung in den Container, und die Buchfuehrung des Backlogs ueber seine Nummern.
#
# Absichtlich **ohne** die Testreihe: Die laeuft ohnehin, weil `make test` und `make check` sie
# ausfuehren und niemand sie vergisst. Vergessen werden die vier hier, und die sind zusammen unter
# einer Sekunde durch -- ein Hook, den man merkt, wird abgeschaltet.
#
# Eingeschaltet wird er einmal je Klon:
#
#     git config core.hooksPath .githooks
#
# Umgangen wird er mit `git commit --no-verify`, was fuer einen halbfertigen Zwischenstand in
# Ordnung ist. Vor dem Push gehoert `make check` gelaufen.

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v python3 >/dev/null 2>&1; then
    echo "Hinweis: python3 fehlt, die vier Pruefungen entfallen." >&2
    exit 0
fi

for pruefung in language_check check_anchors check_settings check_numbers; do
    if ! python3 "tools/$pruefung.py" >/dev/null; then
        echo "" >&2
        echo "  tools/$pruefung.py meldet etwas. Im Klartext:" >&2
        echo "" >&2
        python3 "tools/$pruefung.py" >&2 || true
        echo "" >&2
        echo "  (Zum Umgehen: git commit --no-verify)" >&2
        exit 1
    fi
done
