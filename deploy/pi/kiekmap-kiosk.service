# The visitor view as a service.
#
# Copy to /etc/systemd/system/, then:  sudo systemctl enable --now kiekmap-kiosk
#
# Why a service and not an autostart: systemd restarts Chromium when it crashes, and the device
# comes back into the same state after a pulled power plug. An autostart in the user profile can
# do neither.

[Unit]
Description=Kiekmap kiosk (cage + Chromium)
# Only once Docker runs -- otherwise the start script waits needlessly for an API that has not
# been started at all yet.
After=docker.service systemd-user-sessions.service
Wants=docker.service
# The login prompt on tty1 holds the terminal the kiosk needs. Without these two lines the service
# fails at once with "Failed to set up standard input: Operation not permitted" (status 208/STDIN)
# and restarts every five seconds into the same failure. Found on the first Pi, 1 November 2026.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=kiekmap
ExecStart=/usr/local/bin/kiekmap-kiosk

# cage needs a real session on a console, otherwise it finds no output device. The four lines
# together are what turns a system service into a session-capable login -- leave one of them out
# and cage starts with "unable to open primary DRM device".
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-fail
UtmpIdentifier=tty1
# A clean terminal on every start, so that a restart after a crash finds it as the first start did.
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

StandardOutput=journal
StandardError=journal

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
