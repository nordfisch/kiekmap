#!/bin/sh
# Starts the visitor view full screen -- what the museum sees in the morning.
#
# Two things happen here, and both have a reason:
#
#   1. Wait until the API answers. Without it the device greets its visitors for a few seconds
#      after switching on with an error page -- and that page stays, because Chromium does not
#      reload by itself.
#   2. cage instead of a desktop. cage is a tiny Wayland compositor that shows exactly one
#      program full screen. Nothing can push itself in front, no wallpaper flashes up, no update
#      notices, no screen saver.
#
# Called by kiekmap-kiosk.service, not by hand.

set -eu

ADDRESS="${KIEKMAP_URL:-http://localhost/}"
HEALTH="${ADDRESS%/}/api/health"

# A fresh browser profile on every start. After a crash or a power cut nothing from yesterday is
# left -- no half-loaded state, no cache that swallows the update.
PROFILE="$(mktemp -d /tmp/kiekmap-chromium.XXXXXX)"
trap 'rm -rf "$PROFILE"' EXIT

echo "Waiting for $HEALTH ..."
ATTEMPT=0
while ! curl -sf --max-time 3 "$HEALTH" >/dev/null 2>&1; do
    ATTEMPT=$((ATTEMPT + 1))
    # Start anyway after five minutes. Better an error page that somebody sees and reports than a
    # black screen where nobody can tell whether the device is running at all.
    if [ "$ATTEMPT" -gt 150 ]; then
        echo "The API does not answer -- starting anyway." >&2
        break
    fi
    sleep 2
done

exec cage -- chromium-browser \
    --kiosk "$ADDRESS" \
    --ozone-platform=wayland \
    --user-data-dir="$PROFILE" \
    --no-first-run \
    --noerrdialogs \
    --disable-infobars \
    --disable-translate \
    --disable-features=TranslateUI \
    `# After a pulled power plug Chromium otherwise asks "Restore pages?" -- a dialog in the` \
    `# middle of the exhibition that nobody clicks away.` \
    --disable-session-crashed-bubble \
    --hide-crash-restore-bubble \
    `# A swipe to the right otherwise triggers "back". On a map that is swiped, that is a daily` \
    `# annoyance.` \
    --overscroll-history-navigation=0 \
    `# Pinch zoom stays on -- the map lives on it.` \
    --disable-pinch=false \
    --autoplay-policy=no-user-gesture-required
