#!/bin/sh
# Mounts a USB volume under /media/<label>.
#
# Raspberry Pi OS Lite has no desktop and therefore no automounter -- a stick that is plugged in
# simply does not show up. This script is called by the udev rule 99-kiekmap-usb.rules and closes
# exactly that gap.
#
# Two things are easy to get wrong here:
#
#   1. Mounting directly out of a udev RUN instruction goes wrong: udev clears away the child
#      processes of an event. Hence "systemd-mount" -- it hands the mount on to systemd and
#      returns at once.
#   2. A FAT or exFAT stick knows no owners. Without "uid=" it belongs to root, and the service in
#      the container (UID 1000) may not write to it. The backup would then fail only after
#      somebody has pressed the button.
#
# Usage:  kiekmap-usb-mount mount    /dev/sda1 [label] [filesystem]
#         kiekmap-usb-mount unmount  /dev/sda1

set -eu

# Has to match the UID in the container, see backend/Dockerfile.
SERVICE_UID=1000
SERVICE_GID=1000

ACTION="${1:-}"
DEVICE="${2:-}"
LABEL="${3:-}"
FILESYSTEM="${4:-}"

[ -n "$ACTION" ] && [ -n "$DEVICE" ] || {
    echo "Usage: $0 mount|unmount /dev/sdX1 [label] [filesystem]" >&2
    exit 2
}

# Letters, digits, hyphen and underscore only: a label like "Kalle's stick / 2024" would otherwise
# open up a path nobody meant.
clean() {
    printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40
}

case "$ACTION" in
mount)
    NAME=$(clean "${LABEL:-$(basename "$DEVICE")}")
    [ -n "$NAME" ] || NAME=$(basename "$DEVICE")
    TARGET="/media/$NAME"

    case "$FILESYSTEM" in
    vfat | exfat | ntfs | ntfs3)
        # Filesystems without ownership: the permissions come into being at mount time.
        OPTIONS="uid=$SERVICE_UID,gid=$SERVICE_GID,umask=0022,noatime"
        ;;
    *)
        # ext4 and relatives bring their own owners along.
        OPTIONS="noatime"
        ;;
    esac

    mkdir -p "$TARGET"
    exec systemd-mount --no-block --collect --options "$OPTIONS" "$DEVICE" "$TARGET"
    ;;

unmount)
    # After it has been pulled the label can no longer be learned -- unmount by device.
    exec systemd-umount "$DEVICE"
    ;;

*)
    echo "Unknown action: $ACTION" >&2
    exit 2
    ;;
esac
