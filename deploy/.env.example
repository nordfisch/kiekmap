# Copy to .env (in the project root) and adjust.
# The .env is not versioned.

# The version that is to run on the device. In operation a release tag, not "latest" -- so that it
# is traceable at any time what is installed on the Pi.
KIEKMAP_VERSION=dev

# The language the device speaks: de or en. Interface, messages and date labels follow it.
# An unknown value stops the backend at startup instead of falling back to German in silence.
KIEKMAP_LANGUAGE=de

# PIN for the admin area, as a hash. The whole line is produced by:
#   cd backend && .venv/bin/python -m app.cli pin
# Empty means: the admin area lets nobody in, and says so.
KIEKMAP_ADMIN_PIN_HASH=

# Where the data lies. Takes effect in development only (`make dev`, the CLI) -- in the container
# the place stands in deploy/docker-compose.yml and is set from there. Whoever wants to move the
# data on the device (to a USB disk instead of the SD card, say) changes the left side of the
# mount there, not this line.
# KIEKMAP_DATA_DIR=/data

# Everything else in this file reaches the container as well -- it is read as `env_file`. Which
# settings exist is in backend/app/config.py; those of the import (KIEKMAP_IMPORT_TAGS, _CREDIT,
# _PROVENANCE) are described in docs/adaption.md.
