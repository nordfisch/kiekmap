# Kopieren nach .env (im Projektwurzelverzeichnis) und anpassen.
# Die .env wird nicht versioniert.

# Version, die auf dem Geraet laufen soll. Im Betrieb ein Release-Tag, nicht "latest" --
# damit jederzeit nachvollziehbar ist, was auf dem Pi installiert ist.
PHOTOMAP_VERSION=dev

# PIN fuer den Admin-Bereich, als Hash. Die ganze Zeile erzeugt:
#   cd backend && .venv/bin/python -m app.cli pin
# Leer bedeutet: der Admin-Bereich laesst niemanden hinein und sagt das auch.
PHOTOMAP_ADMIN_PIN_HASH=

# Nur ueberschreiben, wenn die Daten woanders liegen sollen (etwa auf einer USB-Festplatte
# statt auf der SD-Karte).
# PHOTOMAP_DATA_DIR=/data
