# Kopieren nach .env (im Projektwurzelverzeichnis) und anpassen.
# Die .env wird nicht versioniert.

# Version, die auf dem Geraet laufen soll. Im Betrieb ein Release-Tag, nicht "latest" --
# damit jederzeit nachvollziehbar ist, was auf dem Pi installiert ist.
PHOTOMAP_VERSION=dev

# PIN fuer den Admin-Bereich, als Hash. Die ganze Zeile erzeugt:
#   cd backend && .venv/bin/python -m app.cli pin
# Leer bedeutet: der Admin-Bereich laesst niemanden hinein und sagt das auch.
PHOTOMAP_ADMIN_PIN_HASH=

# Wo die Daten liegen. Wirkt nur im Entwicklungsbetrieb (`make dev`, die CLI) -- im Container
# steht der Ort in deploy/docker-compose.yml und wird von dort gesetzt. Wer die Daten auf dem
# Geraet verlegen will (etwa auf eine USB-Festplatte statt auf die SD-Karte), aendert dort die
# linke Seite der Einhaengung, nicht diese Zeile.
# PHOTOMAP_DATA_DIR=/data

# Alles Weitere aus dieser Datei erreicht den Container ebenfalls -- sie wird als `env_file`
# eingelesen. Welche Einstellungen es gibt, steht in backend/app/config.py; die des Imports
# (PHOTOMAP_IMPORT_TAGS, _CREDIT, _PROVENANCE) sind in docs/adaption.md beschrieben.
